        "responses": {
          "200": { "description": "Tenant rent list" }
        }
      }
    },
    "/rent/{id}/submit-proof": {
      "post": {
        "tags": ["Rent Management"],
        "summary": "Student submits transaction ID and payment proof details",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentMode", "amountPaid"],
                "properties": {
                  "paymentMode": { "type": "string", "enum": ["cash", "upi", "bank_transfer", "cheque", "online"] },
                  "referenceNo": { "type": "string" },
                  "amountPaid": { "type": "number" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment proof submitted, status under_review" }
        }
      }
    },
    "/rent/{id}/approve": {
      "post": {
        "tags": ["Rent Management"],
        "summary": "Owner/Manager approves a payment proof receipt",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "pgId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Payment approved successfully" }
        }
      }
    },
    "/rent/{id}/reject": {
      "post": {
        "tags": ["Rent Management"],
        "summary": "Owner/Manager rejects a payment proof (resets back to pending/overdue)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "pgId", "in": "query", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notes": { "type": "string", "description": "Reason for rejection" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment rejected successfully" }
        }
      }
    },
    "/rent/{id}": {
      "patch": {
        "tags": ["Rent Management"],
        "summary": "Update specific fields of a rent payment record",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "pgId", "in": "query", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "number" },
                  "amountPaid": { "type": "number" },
                  "notes": { "type": "string" },
                  "status": { "type": "string", "enum": ["pending", "under_review", "paid", "partial", "overdue"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Rent record updated successfully" }
        }
      },
      "delete": {
        "tags": ["Rent Management"],
        "summary": "Delete a rent record (soft delete)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "pgId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Rent record deleted successfully" }
        }
      }
    },
